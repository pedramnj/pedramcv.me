# Copy to /etc/pedramcv/proxy.env on the origin box (chmod 600, owner pcvproxy).
# Never commit the real values.

# Fine-grained PAT scoped ONLY to pedramnj/pipeline-playground with
# "Actions: Read and write" + "Metadata: Read-only". Nothing else.
GH_TOKEN=github_pat_xxx

# Must match the CALLBACK_SECRET Actions secret in the pipeline-playground repo.
CALLBACK_SECRET=xxx

# Defaults below are fine; override only if you change the repo/limits.
GH_OWNER=pedramnj
GH_REPO=pipeline-playground
GH_WORKFLOW=playground.yml
GH_REF=main
ALLOW_ORIGIN=https://pedramcv.me
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787

# Abuse controls
MAX_CODE_BYTES=16384
RL_PER_MIN=5
RL_PER_HOUR=20
MAX_CONCURRENT=3
DAILY_QUOTA=300
